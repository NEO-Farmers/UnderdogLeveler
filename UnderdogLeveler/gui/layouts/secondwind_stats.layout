FrameWidgetClass SecondWindStatsRoot
{
 position 0 0
 size 1 1
 halign fill
 valign fill
 visible 1
 {
  PanelWidgetClass SWStatsScreenTint
  {
   position 0 0
   size 1 1
   color 0 0 0 255
   style DayZDefaultPanel
   {
   }
  }
  PanelWidgetClass SWStatsBackground
  {
   position 0.14 0.04
   size 0.72 0.92
